/* Three panes: manager and worker list on the left, the selected worker on the right.
 *
 * Deliberately plain. This should read like a terminal that happens to have regions,
 * not like a dashboard: the terminal's own background, one dim rule between panes, and
 * colour reserved for lifecycle and attention. Claude itself owns conversation rendering.
 */

Screen {
    layers: base overlay;
    background: $background;
}

#body {
    height: 1fr;
}

#left-column {
    width: 42%;
    min-width: 40;
    border-right: solid $panel;
}

#manager-pane {
    height: 1fr;
    border-bottom: solid $panel;
}

#worker-list-pane {
    height: 1fr;
}

#worker-pane {
    width: 1fr;
}

/* A quiet label, not a header bar. */
.pane-title {
    color: $text-muted;
    padding: 0 1;
    height: 1;
}

#manager-status {
    padding: 0 1;
    height: auto;
}

#manager-log {
    padding: 1 1 0 1;
    height: 1fr;
    color: $text-muted;
}

#manager-input {
    height: 3;
    border: none;
    background: $background;
    padding: 1 1 0 1;
}

#worker-table {
    height: 1fr;
    background: $background;
}

/* The one element allowed to shout, because it is the one that means "you". */
#attention-banner {
    color: $warning;
    border-left: thick $warning;
    padding: 0 1;
    height: auto;
    margin: 0 0 1 0;
}

#session-detail {
    padding: 0 1;
    height: 1fr;
}

#enter-hint {
    color: $text-muted;
    padding: 0 1;
    height: 2;
}

#interrupt-button {
    width: 18;
    min-width: 18;
    height: 3;
    border: none;
    background: $background;
}

HelpScreen {
    align: center middle;
}

#help-body {
    width: 84;
    max-width: 96%;
    height: 80%;
    border: solid $panel;
    background: $surface;
    padding: 1 2;
}
