/* Three panes: manager and worker list on the left, the selected worker on the right.
 *
 * Deliberately plain. This should read like a terminal that happens to have regions,
 * not like a dashboard: the terminal's own background, one dim rule between panes, and
 * colour reserved for the two things that are actually actionable -- who is speaking and
 * what needs the user. Anything decorative competes with the transcript, which is the
 * only content on screen worth reading closely.
 */

Screen {
    layers: base overlay;
    background: $background;
}

#body {
    height: 1fr;
}

#left-column {
    width: 42%;
    min-width: 40;
    border-right: solid $panel;
}

#manager-pane {
    height: 1fr;
    border-bottom: solid $panel;
}

#worker-list-pane {
    height: 1fr;
}

#worker-pane {
    width: 1fr;
}

/* A quiet label, not a header bar. */
.pane-title {
    color: $text-muted;
    padding: 0 1;
    height: 1;
}

#manager-scroll {
    height: 1fr;
    padding: 0 1;
}

#manager-input,
#worker-input {
    height: 3;
    border: none;
    background: $background;
    padding: 1 1 0 1;
}

#worker-table {
    height: 1fr;
    background: $background;
}

/* The one element allowed to shout, because it is the one that means "you". */
#attention-banner {
    color: $warning;
    border-left: thick $warning;
    padding: 0 1;
    height: auto;
    margin: 0 0 1 0;
}

#transcript-scroll {
    height: 1fr;
    padding: 0 1;
}

#worker-controls {
    height: 3;
}

#worker-controls #worker-input {
    width: 1fr;
}

#interrupt-button {
    width: 13;
    min-width: 13;
}

HelpScreen {
    align: center middle;
}

#help-body {
    width: 84;
    max-width: 96%;
    height: 80%;
    border: solid $panel;
    background: $surface;
    padding: 1 2;
}
